rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSha256(hash) {
      return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]{64}$');
    }

    function isValidPhone(phone) {
      return phone is string && phone.size() == 13 && phone.matches('^\\+256\\d{9}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'kalemeragodie@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // --- Validation Blueprints ---
    function isValidInstitution(data) {
      return data.keys().hasAll(['name', 'locations', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'locations', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.locations is list && data.locations.size() <= 40
        && (data.locations.size() == 0 || (data.locations[0] is string && data.locations[0].size() >= 2 && data.locations[0].size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotice(data, requireInstitution) {
      return data.keys().hasAll(
        requireInstitution
          ? [
              'type', 'status', 'category', 'title', 'publicDescription',
              'location', 'itemDate', 'photos', 'reporterFirstName',
              'verificationPrompts', 'reporterPhoneHash', 'institutionId',
              'institutionName', 'approvedClaimId', 'createdAt', 'updatedAt', 'closedAt'
            ]
          : [
              'type', 'status', 'category', 'title', 'publicDescription',
              'location', 'itemDate', 'photos', 'reporterFirstName',
              'verificationPrompts', 'reporterPhoneHash', 'approvedClaimId',
              'createdAt', 'updatedAt', 'closedAt'
            ]
      )
      && data.keys().hasOnly([
        'type', 'status', 'category', 'title', 'publicDescription',
        'location', 'itemDate', 'photos', 'reporterFirstName',
        'verificationPrompts', 'reporterPhoneHash', 'institutionId',
        'institutionName', 'approvedClaimId', 'createdAt', 'updatedAt', 'closedAt'
      ])
      && data.type in ['found', 'lost']
      && data.status in ['open', 'returned', 'archived', 'removed']
      && data.category is string && data.category.size() >= 2 && data.category.size() <= 40
      && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
      && data.publicDescription is string && data.publicDescription.size() >= 10 && data.publicDescription.size() <= 1200
      && data.location is string && data.location.size() >= 2 && data.location.size() <= 120
      && data.itemDate is string && data.itemDate.size() >= 8 && data.itemDate.size() <= 20 && data.itemDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && data.photos is list && data.photos.size() >= 1 && data.photos.size() <= 5
      && data.photos[0] is string && data.photos[0].size() >= 5 && data.photos[0].size() <= 350000
      && data.reporterFirstName is string && data.reporterFirstName.size() >= 1 && data.reporterFirstName.size() <= 60
      && data.verificationPrompts is list && data.verificationPrompts.size() >= 1 && data.verificationPrompts.size() <= 5
      && data.verificationPrompts[0] is string && data.verificationPrompts[0].size() >= 3 && data.verificationPrompts[0].size() <= 240
      && isValidSha256(data.reporterPhoneHash)
      && (!('institutionId' in data) || isValidId(data.institutionId))
      && (!('institutionName' in data) || (data.institutionName is string && data.institutionName.size() >= 2 && data.institutionName.size() <= 100))
      && (data.approvedClaimId == null || isValidId(data.approvedClaimId))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && (data.closedAt == null || data.closedAt is timestamp);
    }

    function isValidNoticeSecret(data) {
      return data.keys().hasAll(['noticeId', 'reporterName', 'reporterWhatsApp', 'verificationQuestions', 'createdAt'])
        && data.keys().hasOnly(['noticeId', 'reporterName', 'reporterWhatsApp', 'verificationQuestions', 'createdAt'])
        && isValidId(data.noticeId)
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80
        && isValidPhone(data.reporterWhatsApp)
        && data.verificationQuestions is list && data.verificationQuestions.size() >= 1 && data.verificationQuestions.size() <= 5
        && data.verificationQuestions[0] is map
        && data.verificationQuestions[0].keys().hasAll(['question', 'expectedAnswer'])
        && data.verificationQuestions[0].keys().hasOnly(['question', 'expectedAnswer'])
        && data.verificationQuestions[0].question is string && data.verificationQuestions[0].question.size() >= 3 && data.verificationQuestions[0].question.size() <= 240
        && data.verificationQuestions[0].expectedAnswer is string && data.verificationQuestions[0].expectedAnswer.size() >= 1 && data.verificationQuestions[0].expectedAnswer.size() <= 240
        && data.createdAt is timestamp;
    }

    function isValidClaim(data, allowEmptyEvidence) {
      return data.keys().hasAll([
        'claimCodeHash', 'noticeId', 'claimantName', 'claimantPhoneHash',
        'answers', 'evidenceUrls', 'status', 'rejectionReason', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'claimCodeHash', 'noticeId', 'claimantName', 'claimantPhoneHash',
        'answers', 'evidenceUrls', 'status', 'rejectionReason', 'createdAt', 'updatedAt'
      ])
      && isValidSha256(data.claimCodeHash)
      && isValidId(data.noticeId)
      && data.claimantName is string && data.claimantName.size() >= 1 && data.claimantName.size() <= 80
      && isValidSha256(data.claimantPhoneHash)
      && data.answers is list && data.answers.size() >= 1 && data.answers.size() <= 5
      && data.answers[0] is map
      && data.answers[0].keys().hasAll(['question', 'answer'])
      && data.answers[0].keys().hasOnly(['question', 'answer'])
      && data.answers[0].question is string && data.answers[0].question.size() >= 3 && data.answers[0].question.size() <= 240
      && data.answers[0].answer is string && data.answers[0].answer.size() >= 1 && data.answers[0].answer.size() <= 400
      && data.evidenceUrls is list
      && (allowEmptyEvidence ? data.evidenceUrls.size() >= 0 : data.evidenceUrls.size() >= 1)
      && data.evidenceUrls.size() <= 5
      && (data.evidenceUrls.size() == 0 || (data.evidenceUrls[0] is string && data.evidenceUrls[0].size() >= 5 && data.evidenceUrls[0].size() <= 350000))
      && data.status in ['pending', 'approved', 'rejected']
      && (data.rejectionReason == null || (data.rejectionReason is string && data.rejectionReason.size() >= 3 && data.rejectionReason.size() <= 500))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidClaimContact(data) {
      return data.keys().hasAll(['claimId', 'claimantWhatsApp', 'createdAt'])
        && data.keys().hasOnly(['claimId', 'claimantWhatsApp', 'createdAt'])
        && isValidId(data.claimId)
        && isValidPhone(data.claimantWhatsApp)
        && data.createdAt is timestamp;
    }

    function isValidClaimCodeLookup(data) {
      return data.keys().hasAll(['claimId', 'noticeId', 'createdAt'])
        && data.keys().hasOnly(['claimId', 'noticeId', 'createdAt'])
        && isValidId(data.claimId)
        && isValidId(data.noticeId)
        && data.createdAt is timestamp;
    }

    function isValidClaimHandover(data) {
      return data.keys().hasAll(['claimId', 'noticeId', 'reporterName', 'reporterWhatsApp', 'approvedAt'])
        && data.keys().hasOnly(['claimId', 'noticeId', 'reporterName', 'reporterWhatsApp', 'approvedAt'])
        && isValidId(data.claimId)
        && isValidId(data.noticeId)
        && data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80
        && isValidPhone(data.reporterWhatsApp)
        && data.approvedAt is timestamp;
    }

    function isValidStudentAccount(data, requireInstitution) {
      return data.keys().hasAll(
        requireInstitution
          ? ['name', 'phoneNumber', 'pinHash', 'institutionId', 'institutionName', 'createdAt', 'updatedAt']
          : ['name', 'phoneNumber', 'pinHash', 'createdAt', 'updatedAt']
      )
        && data.keys().hasOnly(['name', 'phoneNumber', 'pinHash', 'institutionId', 'institutionName', 'previousPhoneHashes', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isValidPhone(data.phoneNumber)
        && isValidSha256(data.pinHash)
        && (!('institutionId' in data) || isValidId(data.institutionId))
        && (!('institutionName' in data) || (data.institutionName is string && data.institutionName.size() >= 2 && data.institutionName.size() <= 100))
        && (!('previousPhoneHashes' in data) || (
          data.previousPhoneHashes is list
          && data.previousPhoneHashes.size() <= 10
          && (data.previousPhoneHashes.size() == 0 || isValidSha256(data.previousPhoneHashes[0]))
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVaultNoticeEntry(data) {
      return data.keys().hasAll(['noticeId', 'managementToken', 'title', 'type', 'createdAt'])
        && data.keys().hasOnly(['noticeId', 'managementToken', 'title', 'type', 'createdAt'])
        && isValidId(data.noticeId)
        && data.managementToken is string && data.managementToken.size() >= 8 && data.managementToken.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.type in ['found', 'lost']
        && data.createdAt is timestamp;
    }

    function isValidVaultClaimEntry(data) {
      return data.keys().hasAll(['claimId', 'claimCode', 'noticeId', 'noticeTitle', 'createdAt'])
        && data.keys().hasOnly(['claimId', 'claimCode', 'noticeId', 'noticeTitle', 'createdAt'])
        && isValidId(data.claimId)
        && data.claimCode is string && data.claimCode.size() >= 4 && data.claimCode.size() <= 32
        && isValidId(data.noticeId)
        && data.noticeTitle is string && data.noticeTitle.size() >= 1 && data.noticeTitle.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientPhoneHash', 'kind', 'noticeId', 'claimId', 'title', 'message', 'read', 'createdAt'])
        && data.keys().hasOnly(['recipientPhoneHash', 'institutionId', 'kind', 'noticeId', 'claimId', 'title', 'message', 'read', 'createdAt'])
        && isValidSha256(data.recipientPhoneHash)
        && (!('institutionId' in data) || isValidId(data.institutionId))
        && data.kind in ['new_claim', 'claim_resubmitted', 'claim_approved', 'claim_rejected']
        && isValidId(data.noticeId)
        && isValidId(data.claimId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 400
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['targetType', 'targetId', 'reason', 'status', 'createdAt'])
        && data.keys().hasOnly(['targetType', 'targetId', 'reason', 'status', 'createdAt'])
        && data.targetType in ['notice', 'claim']
        && isValidId(data.targetId)
        && data.reason is string && data.reason.size() >= 5 && data.reason.size() <= 600
        && data.status in ['open', 'resolved']
        && data.createdAt is timestamp;
    }

    function isValidBannedNumber(data, phoneId) {
      return data.keys().hasAll(['phoneNumber', 'reason', 'bannedAt'])
        && data.keys().hasOnly(['phoneNumber', 'reason', 'bannedAt'])
        && isValidPhone(data.phoneNumber)
        && data.phoneNumber == phoneId
        && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 400
        && data.bannedAt is timestamp;
    }

    // --- Collection Rules ---

    match /institutions/{institutionId} {
      allow get: if isValidId(institutionId);
      allow list: if isAdmin() || existing().name >= '';
      allow create: if isValidId(institutionId)
        && isValidInstitution(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || institutionId in ['inst_makerere', 'inst_kyambogo']);
      allow update: if isAdmin()
        && isValidId(institutionId)
        && isValidInstitution(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow get: if isValidId(noticeId) && (existing().status in ['open', 'returned', 'archived'] || isAdmin());
      allow list: if existing().status in ['open', 'returned', 'archived'] || isAdmin();
      allow create: if isValidId(noticeId)
        && isValidNotice(incoming(), true)
        && incoming().status == 'open'
        && incoming().approvedClaimId == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().closedAt == null
        && existsAfter(/databases/$(database)/documents/institutions/$(incoming().institutionId));
      allow update: if isValidId(noticeId)
        && isValidNotice(incoming(), false)
        && incoming().type == existing().type
        && incoming().createdAt == existing().createdAt
        && incoming().reporterPhoneHash == existing().reporterPhoneHash
        && (!('institutionId' in existing()) || (
          incoming().institutionId == existing().institutionId
          && incoming().institutionName == existing().institutionName
        ))
        && incoming().updatedAt == request.time
        && (existing().status != 'removed' || isAdmin())
        && (
          isAdmin()
          || (
            existing().status == 'open'
            && incoming().status == 'open'
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'publicDescription', 'location', 'category', 'itemDate', 'updatedAt'])
          )
          || (
            existing().status == 'open'
            && existing().approvedClaimId == null
            && incoming().approvedClaimId is string
            && isValidId(incoming().approvedClaimId)
            && exists(/databases/$(database)/documents/claims/$(incoming().approvedClaimId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['approvedClaimId', 'updatedAt'])
          )
          || (
            existing().status == 'open'
            && existing().approvedClaimId != null
            && incoming().approvedClaimId == null
            && incoming().diff(existing()).affectedKeys().hasOnly(['approvedClaimId', 'updatedAt'])
          )
          || (
            existing().status == 'open'
            && incoming().status in ['returned', 'archived']
            && incoming().closedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'closedAt', 'updatedAt'])
          )
        );
      allow delete: if isAdmin();
    }

    match /noticeSecrets/{tokenHash} {
      allow get: if isValidSha256(tokenHash);
      allow list: if isAdmin();
      allow create: if isValidSha256(tokenHash)
        && isValidNoticeSecret(incoming())
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/notices/$(incoming().noticeId));
      allow update: if isAdmin() || (
        isValidSha256(tokenHash)
        && isValidNoticeSecret(incoming())
        && incoming().noticeId == existing().noticeId
        && incoming().verificationQuestions == existing().verificationQuestions
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['reporterName', 'reporterWhatsApp'])
      );
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow get: if isValidId(claimId);
      allow list: if isAdmin() || existing().noticeId >= '' || existing().claimantPhoneHash >= '';
      allow create: if isValidId(claimId)
        && isValidClaim(incoming(), false)
        && incoming().status == 'pending'
        && incoming().rejectionReason == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/notices/$(incoming().noticeId))
        && get(/databases/$(database)/documents/notices/$(incoming().noticeId)).data.status == 'open';
      allow update: if isValidId(claimId)
        && isValidClaim(incoming(), isAdmin())
        && incoming().claimCodeHash == existing().claimCodeHash
        && incoming().noticeId == existing().noticeId
        && incoming().claimantPhoneHash == existing().claimantPhoneHash
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().status == 'pending'
            && incoming().status == 'approved'
            && incoming().rejectionReason == null
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason', 'updatedAt'])
          )
          || (
            existing().status in ['pending', 'approved']
            && incoming().status == 'rejected'
            && incoming().rejectionReason is string
            && incoming().rejectionReason.size() >= 3
            && incoming().rejectionReason.size() <= 500
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason', 'updatedAt'])
          )
          || (
            existing().status == 'rejected'
            && incoming().status == 'pending'
            && incoming().rejectionReason == null
            && incoming().diff(existing()).affectedKeys().hasOnly(['answers', 'evidenceUrls', 'status', 'rejectionReason', 'updatedAt'])
          )
        );
      allow delete: if isAdmin();
    }

    match /claimContacts/{claimId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(claimId)
        && isValidClaimContact(incoming())
        && incoming().claimId == claimId
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/claims/$(claimId));
      allow update, delete: if isAdmin();
    }

    match /claimCodeLookups/{claimCodeHash} {
      allow get: if isValidSha256(claimCodeHash);
      allow list: if isAdmin();
      allow create: if isValidSha256(claimCodeHash)
        && isValidClaimCodeLookup(incoming())
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/claims/$(incoming().claimId));
      allow update, delete: if isAdmin();
    }

    match /claimHandovers/{claimCodeHash} {
      allow get: if isValidSha256(claimCodeHash);
      allow list: if isAdmin();
      allow create, update: if isValidSha256(claimCodeHash)
        && isValidClaimHandover(incoming())
        && incoming().approvedAt == request.time
        && exists(/databases/$(database)/documents/claims/$(incoming().claimId));
      allow delete: if isAdmin();
    }

    match /accounts/{phoneHash} {
      allow get: if isValidSha256(phoneHash) || isAdmin();
      allow list: if isAdmin();
      allow create: if isValidSha256(phoneHash)
        && isValidStudentAccount(incoming(), true)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/institutions/$(incoming().institutionId));
      allow update: if isValidSha256(phoneHash)
        && isValidStudentAccount(incoming(), false)
        && incoming().phoneNumber == existing().phoneNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!('institutionId' in incoming()) || exists(/databases/$(database)/documents/institutions/$(incoming().institutionId)))
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'pinHash', 'institutionId', 'institutionName', 'updatedAt']);
      allow delete: if isAdmin() || isValidSha256(phoneHash);
    }

    match /accountVaults/{accessKey}/notices/{noticeId} {
      allow get, list: if isValidSha256(accessKey) || isAdmin();
      allow create: if isValidSha256(accessKey)
        && isValidId(noticeId)
        && isValidVaultNoticeEntry(incoming())
        && incoming().noticeId == noticeId
        && incoming().createdAt == request.time;
      allow update: if isValidSha256(accessKey)
        && isValidId(noticeId)
        && isValidVaultNoticeEntry(incoming())
        && incoming().noticeId == existing().noticeId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'managementToken', 'type']);
      allow delete: if isValidSha256(accessKey) || isAdmin();
    }

    match /accountVaults/{accessKey}/claims/{claimId} {
      allow get, list: if isValidSha256(accessKey) || isAdmin();
      allow create: if isValidSha256(accessKey)
        && isValidId(claimId)
        && isValidVaultClaimEntry(incoming())
        && incoming().claimId == claimId
        && incoming().createdAt == request.time;
      allow delete: if isValidSha256(accessKey) || isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId);
      allow list: if isAdmin() || isValidSha256(existing().recipientPhoneHash);
      allow create: if isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().read == false
        && incoming().createdAt == request.time;
      allow update: if isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().recipientPhoneHash == existing().recipientPhoneHash
        && (!('institutionId' in existing()) || incoming().institutionId == existing().institutionId)
        && incoming().kind == existing().kind
        && incoming().noticeId == existing().noticeId
        && incoming().claimId == existing().claimId
        && incoming().title == existing().title
        && incoming().message == existing().message
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isValidId(reportId)
        && isValidReport(incoming())
        && incoming().status == 'open'
        && incoming().createdAt == request.time;
    }

    match /bannedNumbers/{phoneNumber} {
      allow get: if isValidPhone(phoneNumber);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidPhone(phoneNumber)
        && isValidBannedNumber(incoming(), phoneNumber)
        && incoming().bannedAt == request.time;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }
  }
}
